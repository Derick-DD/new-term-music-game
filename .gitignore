# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# generated Sites build and local delivery artifacts
/dist/
/deliverables/
/*.zip
/releases/*.zip
/releases/*-dev-preview.svg

# local presentation/report workspaces (not application source)
/.ppt_master_python/
/presentation_outputs/
/report_outputs/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/.wrangler/
/outputs/
/work/
/data/*.sqlite
/data/*.sqlite-*

# The Skill-compliant static H5 under releases/ is application source and must
# stay versioned. Only generated ZIP and preview QR artifacts are ignored.
